msgid "LICH@TACTICAL@IRON_GOLEM_ASSISTANT@DESCRIPTION"
msgstr ""
"Summons an {GLOBAL.UNITS.IRON_GOLEM_ASSISTANT_UNIT.Hyperlink}."
"{LOC.CONCEPT@SUMMON_LIVE_SHARED}"

msgid "LICH@DLC@SILVERSEAS@TOME_DAMNED@TOME@SPI@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/]+{manaamount} {GLOBAL.ManaConcept.Hyperlink}"
"[bullet/]Per adjacent owned {GLOBAL.OceanConcept.Hyperlink} province:"
"[bulletlist][bullet/]+{adjacentknowledgeamount} "
"{GLOBAL.KnowledgeConcept.Hyperlink}.[bullet/]+{adjacentgoldamount} "
"{GLOBAL.GoldConcept.Hyperlink}.[/bulletlist][bullet/]Fights on this city's "
"domain add an {GLOBAL.UNITS.ACCURSED_LAMENTER.Hyperlink} on your side."
"[bullet/]Counts as a {GLOBAL.ConduitConcept.Hyperlink}[bullet/]Allows the "
"drafting of {GLOBAL.UNITS.ACCURSED_WISP.Hyperlink} and "
"{GLOBAL.UNITS.ACCURSED_LAMENTER.Hyperlink}[/bulletlist]"

msgid "LICH@DLC@SILVERSEAS@TOME_ETERNAL_ICE@TOME@SPI@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/]+{amount} {GLOBAL.KnowledgeConcept.Hyperlink}[bullet/]"
"+{amount2} {GLOBAL.ManaConcept.Hyperlink}[bullet/]In this city's domain:"
"[bulletlist][bullet/]<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> gain "
"{GLOBAL.PROPERTIES.WHITEOUT.Hyperlink}.[bullet/]{amount3} provinces per "
"turn:[bulletlist][bullet/]Gain {GLOBAL.SnowConcept.Hyperlink} and/or "
"{GLOBAL.FrozenWasteConcept.Hyperlink}.[bullet/]Provinces with Water gain "
"{GLOBAL.FrozenWasteConcept.Hyperlink}.[bullet/]Lose "
"{GLOBAL.ChasmConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, "
"{GLOBAL.AshlandsConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, "
"{GLOBAL.CavernFloorConcept.Hyperlink}, and "
"{GLOBAL.GloomTerrainConcept.Hyperlink}.[/bulletlist][/bulletlist]"
"[bullet/]Counts as a {GLOBAL.ResearchPostConcept.Hyperlink}."
"[bullet/]Allows the drafting of {GLOBAL.UNITS.HOARFROST_MANTA.Hyperlink} "
"and {GLOBAL.UNITS.ANCIENT_HOARFROST_MANTA.Hyperlink}[/bulletlist]"

