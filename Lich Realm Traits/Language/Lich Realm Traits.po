msgid "LICH@TRAIT_LICH_VOLCANIC_ERUPTIONS@UNIT_PROPERTY_DESCRIPTION"
msgstr ""
"This unit is in a province affected by volcanic activity and subject to the "
"following:[bulletlist][bullet/]This unit has "
"{GLOBAL.PROPERTIES.LICH_REDUCED_REGENERATE.Hyperlink}.[bullet/]This unit "
"suffers {FireRestistanceReduction} {GLOBAL.FireResistanceConcept.Hyperlink}, "
"but gains {FrostResistanceIncrease} "
"{GLOBAL.FrostResistanceConcept.Hyperlink}.[/bulletlist] Units that are "
"immune to {GLOBAL.FireDamageConcept.Hyperlink} or "
"{GLOBAL.PROPERTIES.BURNING.Hyperlink}, have "
"{GLOBAL.PROPERTIES.DESOLATE_WALK.Hyperlink} or "
"{GLOBAL.PROPERTIES.LAVA_WALK.Hyperlink}, or that are an "
"{GLOBAL.PROPERTIES.INFERNAL_FIEND.Hyperlink} don't suffer reduced health "
"recovery."

msgid "LICH@TRAIT_LICH_VOLCANIC_ERUPTIONS@UNIT_PROPERTY_NAME"
msgstr "Lich Volcanic Heat"

msgid "LICH@TRAIT_LICH_VOLCANIC_ERUPTIONS@NAME"
msgstr "Lich Volcanic Eruptions"

msgid "LICH@TRAIT_LICH_VOLCANIC_ERUPTIONS@DESCRIPTION"
msgstr ""
"Volcanic activity rages beneath this realm's desolate regions.[bulletlist]"
"[bullet/]All surface combat in desolate <<m:"
"{GLOBAL.ProvinceConcept.Hyperlink}>> is affected by "
"{GLOBAL.PROPERTIES.COMBATPROPERTY_VOLCANIC_ERUPTION.Hyperlink}."
"[bullet/]Units in desolate <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> suffer "
"{GLOBAL.PROPERTIES.LICH_VOLCANIC_HEAT_UNIT_PROPERTY.Hyperlink}.[/bulletlist]"

msgid "LICH@UNIT_PROPERTIES_LICH_REDUCED_REGENERATE@NAME"
msgstr "Reduced Regenerate"

msgid "LICH@UNIT_PROPERTIES_LICH_REDUCED_REGENERATE@DESCRIPTION"
msgstr "This unit heals at half its natural rate on the world map."

msgid "LICH@TRAIT_LICH_VOLCANIC_ERUPTIONS@DISPLAY_DESCRIPTION"
msgstr ""
"Units in this {GLOBAL.ProvinceConcept.Hyperlink} suffer:[bulletlist][bullet/]"
"{GLOBAL.PROPERTIES.LICH_VOLCANIC_HEAT_UNIT_PROPERTY.Hyperlink}[bullet/]"
"{GLOBAL.PROPERTIES.COMBATPROPERTY_VOLCANIC_ERUPTION.Hyperlink} in combat[/"
"bulletlist]"

msgid "LICH@TRAIT_AGNOSTIC_MAGIC_MATERIALS@NAME"
msgstr "Agnostic Magic Materials"

msgid "LICH@TRAIT_AGNOSTIC_MAGIC_MATERIALS@DESCRIPTION"
msgstr ""
"Magic materials no longer require specific province themes based on the "
"material type, and can spawn on any valid province on both the surface and "
"underground."

msgid "LICH@TRAIT_ARCTIC_BLIZZARDS@PROPERTY_DESCRIPTION"
msgstr ""
"This unit is in an Arctic Blizzard and subject to the following:[bulletlist]"
"[bullet/]This Unit has {GLOBAL.PROPERTIES.LICH_REDUCED_REGENERATE.Hyperlink}."
"[bullet/]This Unit suffers {Visionrangereduction} "
"{GLOBAL.VisionRangeConcept.Hyperlink}.[bullet/]This Unit gains "
"{GLOBAL.PROPERTIES.UNIVERSAL_CAMOUFLAGE.Hyperlink}.[/bulletlist]\n"
"Units that are immune to {GLOBAL.FrostDamageConcept.Hyperlink}, "
"{GLOBAL.PROPERTIES.CHILLED.Hyperlink}, {GLOBAL.PROPERTIES.FROZEN.Hyperlink}, "
"or have {GLOBAL.PROPERTIES.ARCTIC_WALK.Hyperlink} don't suffer reduced "
"health recovery."

msgid "LICH@TRAIT_ARCTIC_BLIZZARDS@COMBAT_PROPERTY_DESCRIPTION"
msgstr ""
"At the end of the attacker's {GLOBAL.TurnConcept.Hyperlink}:[bulletlist]"
"[bullet/]All units have a {ChilledChance} chance of becoming "
"{GLOBAL.PROPERTIES.CHILLED.Hyperlink}.[bullet/]{frozenchange} base chance of "
"all {GLOBAL.PROPERTIES.WET.Hyperlink} units suffering "
"{GLOBAL.PROPERTIES.FROZEN.Hyperlink}.[/bulletlist]"

msgid "LICH@TRAIT_HOSTILE_OCEANS@PROPERTY_DESCRIPTION"
msgstr ""
"This unit is in a Sea Storm and subject to the following:[bulletlist]"
"[bullet/]This unit has {GLOBAL.PROPERTIES.LICH_REDUCED_REGENERATE.Hyperlink}."
"[bullet/]This unit suffers "
"{REALM_TRAIT_UNIT_PROPERTY_STAT_BONUS>BONUS>SightRange} "
"{GLOBAL.VisionRangeConcept.Hyperlink}.[bullet/]This unit gains "
"{GLOBAL.PROPERTIES.UNIVERSAL_CAMOUFLAGE.Hyperlink}.[/bulletlist]\n"
"Units that are immune to {GLOBAL.LightningDamageConcept.Hyperlink} or "
"{GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink}, or have "
"{GLOBAL.PROPERTIES.WATER_WALK.Hyperlink}, "
"{GLOBAL.PROPERTIES.WATER_MOVEMENT.Hyperlink}, or "
"{GLOBAL.PROPERTIES.AMPHIBIOUS_MOVEMENT.Hyperlink} don't suffer reduced "
"health recovery."

msgid "LICH@TRAIT_LICH_REGENERATING_INFESTATIONS@NAME"
msgstr "Lich Regenerating Infestations"
